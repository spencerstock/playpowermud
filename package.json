{
  "name": "playpowermud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based Powermud client: terminal, aliases, comms, world map.",
  "scripts": {
    "dev": "yarn build && node --import tsx server/dev.ts",
    "relay": "node --import tsx server/standalone.ts",
    "build": "yarn build:css && yarn build:app",
    "build:css": "mkdir -p public/build && cp node_modules/@xterm/xterm/css/xterm.css public/build/xterm.css",
    "build:app": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'server/**/*.test.ts'"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
